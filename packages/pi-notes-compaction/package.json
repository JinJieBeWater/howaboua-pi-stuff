{
	"name": "@howaboua/pi-notes-compaction",
	"version": "0.0.13",
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/IgorWarzocha/howaboua-pi-stuff.git",
		"directory": "packages/pi-notes-compaction"
	},
	"files": [
		"dist",
		"src",
		"README.md",
		"PCC-INTEGRATION.md",
		"changelog.ts",
		"CHANGELOG.md"
	],
	"engines": {
		"node": ">=22.18.0"
	},
	"type": "module",
	"description": "Provider-neutral session notes and notes-guided context windows for Pi",
	"license": "MIT",
	"pi": {
		"extensions": [
			"./changelog.ts",
			"./dist/index.js"
		]
	},
	"main": "./dist/index.js",
	"types": "./src/index.ts",
	"scripts": {
		"build": "bun ../../scripts/build-startup-bundle.mjs pi-notes-compaction",
		"prepack": "bun run check && bun run build",
		"check": "bun run lint && bun run typecheck",
		"lint": "biome check .",
		"format": "biome check --write .",
		"typecheck": "tsgo --noEmit"
	},
	"dependencies": {
		"better-sqlite3": "13.0.3"
	},
	"devDependencies": {
		"@howaboua/pi-codex-conversion": "4.0.7",
		"@types/better-sqlite3": "9.6.0"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=1.2.0",
		"@earendil-works/pi-agent-core": ">=1.0.4",
		"@earendil-works/pi-ai": ">=1.0.4",
		"@earendil-works/pi-tui": ">=1.0.4",
		"@howaboua/pi-codex-conversion": ">=4.0.7",
		"typebox": "*"
	},
	"peerDependenciesMeta": {
		"@howaboua/pi-codex-conversion": {
			"optional": true
		}
	},
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./context-sharing": {
			"types": "./src/context-sharing.ts",
			"import": "./dist/context-sharing.js",
			"default": "./dist/context-sharing.js"
		}
	}
}
